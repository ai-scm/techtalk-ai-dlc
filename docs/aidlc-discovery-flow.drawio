<mxfile host="app.diagrams.net">
  <diagram name="AI-DLC Discovery Flow" id="discovery1">
    <mxGraphModel dx="1800" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="AI-DLC Discovery — Flujo Secuencial" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="400" y="20" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="3" value="Genera los insumos de producto y técnicos que AI-DLC consume como entrada" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="400" y="55" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="10" value="PASO 1: Activación" style="text;html=1;align=left;fontSize=14;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1565C0;" parent="1" vertex="1"><mxGeometry x="100" y="100" width="300" height="25" as="geometry"/></mxCell>
        <mxCell id="11" value="El usuario ejecuta &quot;start aidlc-discovery&quot; o &quot;inicia aidlc-discovery&quot;&#10;&#10;Instrucción leída:&#10;  .kiro/skills/discovery-orchestrator/SKILL.md&#10;  → Referencia: .kiro/aidlc-common/protocols/orchestrator-protocol.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="130" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="20" value="PASO 2: Welcome + Shared Selection" style="text;html=1;align=left;fontSize=14;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1565C0;" parent="1" vertex="1"><mxGeometry x="100" y="250" width="400" height="25" as="geometry"/></mxCell>
        <mxCell id="21" value="Se crea la carpeta Product-Definition/ y se preguntan configuraciones:&#10;&#10;• project-type → Greenfield&#10;• depth → Quick (solo preguntas [CORE])&#10;• mode → Sequential (un rol a la vez)&#10;• interaction → Batch (preguntas en archivo .md)&#10;&#10;Artefacto generado:&#10;  Product-Definition/interview/setup-selection.md&#10;  Product-Definition/state/session-index.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="280" width="500" height="170" as="geometry"/></mxCell>
        <mxCell id="30" value="PASO 3 y 4: Entrevistas en Paralelo (Fork)" style="text;html=1;align=left;fontSize=14;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="100" y="480" width="500" height="25" as="geometry"/></mxCell>
        <mxCell id="29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;" parent="1" vertex="1"><mxGeometry x="80" y="510" width="1100" height="380" as="geometry"/></mxCell>
        <mxCell id="28" value="FORK" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=10;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="560" y="520" width="80" height="40" as="geometry"/></mxCell>
        <mxCell id="31" value="👔 PASO 3: Product Discovery&#10;(Rol: PM / Negocio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;align=center;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="100" y="590" width="480" height="280" as="geometry"/></mxCell>
        <mxCell id="32" value="Entrevista guiada al usuario sobre la visión del producto:&#10;&#10;Instrucción: .kiro/skills/product-discovery/SKILL.md&#10;Bank de preguntas: aidlc-discovery-rules/.../business/vision-interview.md&#10;&#10;Temas cubiertos:&#10;• Problema a resolver&#10;• Usuarios objetivo y personas&#10;• Métricas de éxito&#10;• Alcance MVP (Features IN / Features OUT)&#10;• Riesgos identificados&#10;&#10;Gate: El usuario aprueba el documento antes de continuar.&#10;&#10;Artefactos generados:&#10;  Product-Definition/vision-document.md&#10;  Product-Definition/interview/business/vision-questions.md&#10;  Product-Definition/interview/business/vision-answers-history.md&#10;  Product-Definition/state/business-state.md&#10;  Product-Definition/audit/business-audit.md" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=5;" parent="1" vertex="1"><mxGeometry x="110" y="625" width="460" height="240" as="geometry"/></mxCell>
        <mxCell id="41" value="🔧 PASO 4: Tech Discovery&#10;(Rol: Tech Lead)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;align=center;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="620" y="590" width="480" height="280" as="geometry"/></mxCell>
        <mxCell id="42" value="Entrevista guiada al usuario sobre restricciones técnicas:&#10;&#10;Instrucción: .kiro/skills/tech-discovery/SKILL.md&#10;Bank de preguntas: aidlc-discovery-rules/.../technical/tech-env-interview.md&#10;&#10;Temas cubiertos:&#10;• Lenguajes requeridos/prohibidos&#10;• Frameworks obligatorios&#10;• Cloud services (allow/disallow list)&#10;• Arquitectura y patrones&#10;• Seguridad (auth, cifrado)&#10;• Estrategia de testing&#10;&#10;Gate: El usuario aprueba el documento antes de continuar.&#10;&#10;Artefactos generados:&#10;  Product-Definition/technical-environment.md&#10;  Product-Definition/interview/technical/tech-env-questions.md&#10;  Product-Definition/interview/technical/tech-env-answers-history.md&#10;  Product-Definition/state/technical-state.md&#10;  Product-Definition/audit/technical-audit.md" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=5;" parent="1" vertex="1"><mxGeometry x="630" y="625" width="460" height="240" as="geometry"/></mxCell>
        <mxCell id="43" value="JOIN" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=10;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="560" y="890" width="80" height="40" as="geometry"/></mxCell>
        <mxCell id="85" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#4CAF50;" parent="1" source="28" target="31" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="86" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#FF9800;" parent="1" source="28" target="41" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="87" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#4CAF50;" parent="1" source="31" target="43" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="88" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#FF9800;" parent="1" source="41" target="43" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="50" value="PASO 5: Open Questions (Join Barrier)" style="text;html=1;align=left;fontSize=14;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#6A1B9A;" parent="1" vertex="1"><mxGeometry x="100" y="960" width="500" height="25" as="geometry"/></mxCell>
        <mxCell id="51" value="Ambos roles completados. Se consolidan preguntas abiertas:&#10;&#10;Instrucción: .kiro/skills/open-questions/SKILL.md&#10;&#10;Acciones:&#10;• Lee vision-document.md + technical-environment.md&#10;• Detecta contradicciones entre visión y constraints&#10;• Consolida preguntas sin resolver de ambos roles&#10;• En este proyecto: 4 preguntas pre-declaradas, todas resueltas&#10;&#10;Artefacto generado:&#10;  Product-Definition/open-questions.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9C27B0;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="990" width="550" height="190" as="geometry"/></mxCell>
        <mxCell id="60" value="PASO 6: Handoff → AI-DLC" style="text;html=1;align=left;fontSize=14;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#B71C1C;" parent="1" vertex="1"><mxGeometry x="100" y="1210" width="400" height="25" as="geometry"/></mxCell>
        <mxCell id="61" value="Se genera un prompt de handoff para iniciar AI-DLC:&#10;&#10;&quot;Using AI-DLC, start Requirements Analysis for this product.&#10; Before anything else, load these inputs from Product-Definition/:&#10; - vision-document.md&#10; - technical-environment.md&#10; - open-questions.md&#10; Treat the MVP Features IN list as the scope boundary.&#10; Honour the allow/deny lists in technical-environment.md as constraints.&quot;&#10;&#10;Este prompt se copia y se pega en la siguiente sesión de AI-DLC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="1240" width="550" height="180" as="geometry"/></mxCell>
        <mxCell id="70" value="RESUMEN DE ARTEFACTOS FINALES" style="text;html=1;align=left;fontSize=14;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="100" y="1450" width="400" height="25" as="geometry"/></mxCell>
        <mxCell id="71" value="Product-Definition/&#10;├── vision-document.md                    ← Visión de negocio completa&#10;├── technical-environment.md              ← Restricciones técnicas&#10;├── open-questions.md                     ← Preguntas abiertas consolidadas&#10;├── state/&#10;│   ├── session-index.md                  ← Estado del Discovery&#10;│   ├── business-state.md                 ← Estado del rol PM&#10;│   └── technical-state.md                ← Estado del rol Tech Lead&#10;├── interview/&#10;│   ├── setup-selection.md                ← Configuración inicial&#10;│   ├── business/&#10;│   │   ├── vision-questions.md           ← Preguntas realizadas&#10;│   │   └── vision-answers-history.md     ← Respuestas del usuario&#10;│   └── technical/&#10;│       ├── tech-env-questions.md         ← Preguntas realizadas&#10;│       └── tech-env-answers-history.md   ← Respuestas del usuario&#10;└── audit/&#10;    ├── business-audit.md                 ← Log de interacciones PM&#10;    └── technical-audit.md                ← Log de interacciones Tech" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacing=10;fontSize=10;fontFamily=Courier New;" parent="1" vertex="1"><mxGeometry x="100" y="1480" width="550" height="340" as="geometry"/></mxCell>
        <mxCell id="80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#1976D2;" parent="1" source="11" target="21" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="81" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;" parent="1" source="21" target="28" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="83" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#9C27B0;" parent="1" source="43" target="51" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="84" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#C62828;" parent="1" source="51" target="61" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
