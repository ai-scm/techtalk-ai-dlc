<mxfile host="app.diagrams.net">
  <diagram name="AI-DLC Workflow" id="workflow1">
    <mxGraphModel dx="1800" dy="6000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="5800">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="AI-DLC — Workflow Ejecutado (Dog Keeper)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="350" y="20" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="3" value="Fases: INCEPTION (qué y por qué) → CONSTRUCTION (cómo) → OPERATIONS (placeholder)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="300" y="55" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="4" value="Instrucción principal: .aidlc/aidlc-rules/aws-aidlc-rules/core-workflow.md" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="350" y="75" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="100" value="🔵 INCEPTION PHASE" style="text;html=1;align=left;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1565C0;" parent="1" vertex="1"><mxGeometry x="100" y="110" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="110" value="1. Workspace Detection" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="100" y="150" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="111" value="• Escanea el workspace: no hay código → Greenfield&#10;• Crea aidlc-docs/ y aidlc-state.md&#10;&#10;Artefacto:&#10;  aidlc-docs/aidlc-state.md&#10;  aidlc-docs/audit.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="175" width="500" height="100" as="geometry"/></mxCell>
        <mxCell id="120" value="2. Requirements Analysis" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="100" y="300" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="121" value="• Carga Product-Definition/ (vision + tech + open-questions)&#10;• Genera 13 preguntas de verificación (archivo .md, no en chat)&#10;• Analiza respuestas: sin contradicciones&#10;• Decide extensiones: Security NO, Resiliency NO, PBT Parcial&#10;• Genera documento de requerimientos&#10;&#10;Decisiones de negocio:&#10;  • Best-effort availability (sin SLA)&#10;  • &lt;50 usuarios concurrentes, latencia &lt;5s&#10;  • Max 3 fotos por mascota (5MB, JPG/PNG)&#10;  • Max 3 solicitudes activas por adoptante&#10;  • Eliminación en cascada al borrar cuenta&#10;&#10;Artefactos:&#10;  aidlc-docs/inception/requirements/requirements.md&#10;  aidlc-docs/inception/requirements/requirement-verification-questions.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="325" width="550" height="270" as="geometry"/></mxCell>
        <mxCell id="130" value="3. User Stories" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="100" y="620" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="131" value="• Part 1 (Planning): 7 preguntas sobre formato y organización&#10;  → Feature-based, ~22 historias, MoSCoW, español&#10;• Part 2 (Generation): Genera 3 personas + 22 user stories&#10;&#10;Artefactos:&#10;  aidlc-docs/inception/user-stories/personas.md&#10;  aidlc-docs/inception/user-stories/stories.md&#10;  aidlc-docs/inception/plans/story-generation-plan.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="645" width="550" height="150" as="geometry"/></mxCell>
        <mxCell id="140" value="4. Workflow Planning" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="100" y="820" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="141" value="• Analiza complejidad y determina qué stages ejecutar&#10;• 6 stages a ejecutar, 3 skipped (Reverse Eng, NFR-Req, NFR-Design)&#10;• Risk level: Low&#10;&#10;Artefacto:&#10;  aidlc-docs/inception/plans/execution-plan.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="845" width="550" height="110" as="geometry"/></mxCell>
        <mxCell id="150" value="5. Application Design" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="100" y="980" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="151" value="• 6 preguntas de diseño → Contradicciones detectadas con tech-environment.md&#10;• Clarificación: usuario confirma pivote tecnológico&#10;• Rev.2: usuario solicita agregar BFF entre Frontend y Backend&#10;&#10;Decisiones técnicas (pivote vs Discovery):&#10;  ❌ DynamoDB → ✅ PostgreSQL (SQLAlchemy)&#10;  ❌ Amazon S3 → ✅ Imágenes como bytea en PostgreSQL&#10;  ❌ Amazon Cognito → ✅ Auth propio (bcrypt + JWT)&#10;  ✅ Se introduce BFF (Backend For Frontend)&#10;&#10;Artefactos:&#10;  aidlc-docs/inception/application-design/application-design.md&#10;  aidlc-docs/inception/application-design/components.md&#10;  aidlc-docs/inception/application-design/component-methods.md&#10;  aidlc-docs/inception/application-design/services.md&#10;  aidlc-docs/inception/application-design/component-dependency.md&#10;  aidlc-docs/inception/plans/application-design-plan.md&#10;  aidlc-docs/inception/plans/application-design-clarification.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="1005" width="580" height="310" as="geometry"/></mxCell>
        <mxCell id="160" value="6. Units Generation" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="100" y="1340" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="161" value="• 3 preguntas: cantidad de unidades, estrategia de deploy, estructura&#10;• Decisión: 4 unidades, flat structure, dev local primero&#10;&#10;Unidades definidas:&#10;  1. Backend API (Python/FastAPI, port 8000)&#10;  2. BFF (Python/FastAPI/httpx, port 8001)&#10;  3. Frontend (TypeScript/React/Vite, port 3000)&#10;  4. Infrastructure (TypeScript/AWS CDK)&#10;&#10;Orden de desarrollo: Backend → BFF → Frontend → Infra&#10;&#10;Artefactos:&#10;  aidlc-docs/inception/application-design/unit-of-work.md&#10;  aidlc-docs/inception/application-design/unit-of-work-dependency.md&#10;  aidlc-docs/inception/application-design/unit-of-work-story-map.md&#10;  aidlc-docs/inception/plans/unit-of-work-plan.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="1365" width="580" height="270" as="geometry"/></mxCell>
        <mxCell id="200" value="🟢 CONSTRUCTION PHASE" style="text;html=1;align=left;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#2E7D32;" parent="1" vertex="1"><mxGeometry x="100" y="1670" width="350" height="30" as="geometry"/></mxCell>
        <mxCell id="201" value="Patrón per-unit: Para cada unidad → Functional Design → Infrastructure Design → Code Generation" style="text;html=1;align=left;fontSize=10;fontStyle=2;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="100" y="1700" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="210" value="Unit 1: Backend API" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#33691E;" parent="1" vertex="1"><mxGeometry x="100" y="1730" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="211" value="Functional Design:&#10;  • 4 tablas SQL (users, pets, photos, adoption_requests)&#10;  • 12 conjuntos de reglas de negocio&#10;  • Estado machine: AVAILABLE → IN_PROCESS → ADOPTED&#10;&#10;Infrastructure Design:&#10;  • Dockerfile (python:3.11-slim), K8s manifests, garden.yml&#10;  • PostgreSQL Helm con persistencia (PVC para local)&#10;  • Decisión: seed script para datos de prueba&#10;&#10;Code Generation (12 steps, 35 archivos):&#10;  • main.py, routers/, services/, repositories/, models/, schemas/, core/&#10;  • Tests unitarios (pytest)&#10;  • Dockerfile + manifests + garden.yml&#10;&#10;Artefactos doc:&#10;  aidlc-docs/construction/backend-api/functional-design/domain-entities.md&#10;  aidlc-docs/construction/backend-api/functional-design/business-rules.md&#10;  aidlc-docs/construction/backend-api/functional-design/business-logic-model.md&#10;  aidlc-docs/construction/backend-api/infrastructure-design/infrastructure-design.md&#10;  aidlc-docs/construction/backend-api/infrastructure-design/deployment-architecture.md&#10;  aidlc-docs/construction/backend-api/code/code-summary.md&#10;  aidlc-docs/construction/plans/backend-api-code-generation-plan.md&#10;&#10;Código generado: /backend/ (35 archivos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#689F38;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="1755" width="600" height="420" as="geometry"/></mxCell>
        <mxCell id="220" value="Unit 2: BFF" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#E65100;" parent="1" vertex="1"><mxGeometry x="100" y="2200" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="221" value="Functional Design:&#10;  • Proxy logic, auth flow (login/register orchestration)&#10;  • JWT validation, response adaptation&#10;&#10;Infrastructure Design:&#10;  • Dockerfile, K8s manifests, garden.yml&#10;  • Depends on: deploy.backend&#10;&#10;Code Generation (15 archivos):&#10;  • main.py, routers/, middleware/, client/, core/&#10;  • Tests unitarios (pytest)&#10;&#10;Artefactos doc:&#10;  aidlc-docs/construction/bff/functional-design/business-logic-model.md&#10;  aidlc-docs/construction/bff/functional-design/business-rules.md&#10;  aidlc-docs/construction/bff/functional-design/domain-entities.md&#10;  aidlc-docs/construction/bff/infrastructure-design/infrastructure-design.md&#10;&#10;Código generado: /bff/ (15 archivos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="2225" width="600" height="310" as="geometry"/></mxCell>
        <mxCell id="230" value="Unit 3: Frontend" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#B71C1C;" parent="1" vertex="1"><mxGeometry x="100" y="2560" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="231" value="Functional Design:&#10;  • 10 rutas, 4 features (auth, catalog, publishing, adoption)&#10;  • Component hierarchy, API service design&#10;  • data-testid specifications para automation&#10;&#10;Infrastructure Design:&#10;  • Dockerfile multi-stage (node:20-alpine)&#10;  • K8s manifests + Ingress (/ → frontend, /api → bff)&#10;  • garden.yml con sync + port-forward&#10;&#10;Code Generation (41 archivos):&#10;  • App.tsx, features/, components/, services/, context/, types/&#10;  • vite.config.ts, tailwind.config.ts, tsconfig.json&#10;&#10;Artefactos doc:&#10;  aidlc-docs/construction/frontend/functional-design/frontend-components.md&#10;  aidlc-docs/construction/frontend/infrastructure-design/infrastructure-design.md&#10;&#10;Código generado: /frontend/ (41 archivos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="2585" width="600" height="310" as="geometry"/></mxCell>
        <mxCell id="240" value="Unit 4: Infrastructure (AWS CDK)" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#4A148C;" parent="1" vertex="1"><mxGeometry x="100" y="2920" width="400" height="20" as="geometry"/></mxCell>
        <mxCell id="241" value="Infrastructure Design (11 preguntas al usuario):&#10;  • EKS Fargate (NO Lambda) — misma topología que local&#10;  • ALB (NO API Gateway) — más barato, nativo K8s&#10;  • PostgreSQL in-cluster Helm (NO RDS para POC)&#10;  • VPC existente importada&#10;  • SSM Parameter Store para secretos&#10;  • Solo entorno 'test' (local = dev)&#10;  • Single parent stack (DogKeeperStack)&#10;&#10;Code Generation (11 steps, 15 archivos):&#10;  • 5 Constructs: Networking, ECR, EKS, Monitoring, Pipeline&#10;  • Parent stack (dog-keeper-stack.ts)&#10;  • Entry point (bin/app.ts)&#10;  • Config (config/test.ts)&#10;  • Tests (Jest + CDK Assertions)&#10;&#10;Artefactos doc:&#10;  aidlc-docs/construction/infra-cdk/infrastructure-design/infrastructure-design.md&#10;  aidlc-docs/construction/infra-cdk/infrastructure-design/deployment-architecture.md&#10;  aidlc-docs/construction/infra-cdk/code/code-summary.md&#10;  aidlc-docs/construction/plans/infra-cdk-code-generation-plan.md&#10;  aidlc-docs/construction/plans/infra-cdk-infrastructure-design-questions.md&#10;&#10;Código generado: /infra/cdk/ (15 archivos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7B1FA2;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="2945" width="600" height="400" as="geometry"/></mxCell>
        <mxCell id="250" value="Build and Test" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#2E7D32;" parent="1" vertex="1"><mxGeometry x="100" y="3370" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="251" value="• CDK TypeScript compilación verificada (tsc --noEmit) ✅&#10;• Tests unitarios escritos para las 4 unidades&#10;• Tests de integración definidos (ejecutables con Garden)&#10;• Instrucciones de build/test documentadas&#10;&#10;Artefactos:&#10;  aidlc-docs/construction/build-and-test/build-instructions.md&#10;  aidlc-docs/construction/build-and-test/unit-test-instructions.md&#10;  aidlc-docs/construction/build-and-test/integration-test-instructions.md&#10;  aidlc-docs/construction/build-and-test/build-and-test-summary.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="3395" width="600" height="180" as="geometry"/></mxCell>
        <mxCell id="300" value="🟡 OPERATIONS PHASE (Placeholder)" style="text;html=1;align=left;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#F57F17;" parent="1" vertex="1"><mxGeometry x="100" y="3610" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="301" value="Estado actual del despliegue (post-correcciones manuales):&#10;&#10;• EKS Cluster: dog-keeper-test-eks (K8s 1.31, Fargate)&#10;• Pods running: frontend, bff, backend, db, coredns x2, ALB controller x2&#10;• ALB creado: k8s-dogkeepe-frontend-*.us-east-1.elb.amazonaws.com&#10;• Pipeline CI/CD: 5 stages (Source → Build → Test → Approve → Deploy)&#10;• ECR: 3 repos (dog-keeper-test/backend, /bff, /frontend)&#10;• SSM: 5 parámetros creados&#10;• Acceso kubectl: SSO role mapeado en aws-auth&#10;&#10;Correcciones aplicadas durante deploy:&#10;  • KubectlV31Layer (fix batch/v1beta1)&#10;  • CfnJson para IRSA (fix synth token error)&#10;  • KubernetesPatch para CoreDNS (fix selector missing)&#10;  • ECR repo naming con / (fix Garden registry mismatch)&#10;  • MUTABLE tags (fix pipeline re-runs)&#10;  • ECR Public Gallery base images (fix Docker Hub 429)&#10;  • git init en CodeBuild (fix Garden requires git)&#10;  • ALB Controller permissions (fix DescribeRouteTables)&#10;  • SSO role ARN sin path (fix aws-auth mapping)&#10;  • allowedHosts: true en Vite (fix ALB host blocking)&#10;  • Persistence disabled para Fargate (fix PVC not bound)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;align=left;verticalAlign=top;spacing=10;fontSize=10;" parent="1" vertex="1"><mxGeometry x="100" y="3645" width="600" height="380" as="geometry"/></mxCell>
        <mxCell id="400" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#1976D2;" parent="1" source="111" target="121" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="401" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#1976D2;" parent="1" source="121" target="131" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="402" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#1976D2;" parent="1" source="131" target="141" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="403" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#4CAF50;" parent="1" source="141" target="151" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="404" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#1976D2;" parent="1" source="151" target="161" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="405" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#689F38;" parent="1" source="161" target="211" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="406" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#FFA000;" parent="1" source="211" target="221" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="407" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#C62828;" parent="1" source="221" target="231" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="408" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#7B1FA2;" parent="1" source="231" target="241" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="409" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#2E7D32;" parent="1" source="241" target="251" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="410" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#F57F17;dashed=1;" parent="1" source="251" target="301" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
