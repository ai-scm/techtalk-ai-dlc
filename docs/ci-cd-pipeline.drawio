                <mxCell id="workaround5" value="5. MUTABLE ECR tags&#xa;   (permite re-runs del pipeline)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
