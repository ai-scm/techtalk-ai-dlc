                    <mxGeometry x="350" y="730" width="250" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="workaround3" value="3. ECR Public Gallery base images&#xa;   (evita Docker Hub 429)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="730" width="220" height="35" as="geometry"/>
