                    <mxGeometry x="820" y="500" width="150" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="deploy-result-detail" value="• Garden aplica K8s manifests (deployment, service, ingress)&#xa;• Kaniko construye imágenes que no existan en ECR&#xa;• ALB Controller crea/actualiza el Load Balancer&#xa;• Pods desplegados en Fargate (private subnets)&#xa;• Verificación: kubectl wait --for=condition=ready" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="820" y="520" width="370" height="80" as="geometry"/>
                </mxCell>
