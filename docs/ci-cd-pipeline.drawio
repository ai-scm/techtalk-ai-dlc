                    <mxGeometry x="820" y="610" width="170" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="dag-flow" value="deploy.db → deploy.backend → deploy.bff → deploy.frontend" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=4;fontColor=#7B1FA2;" parent="1" vertex="1">
