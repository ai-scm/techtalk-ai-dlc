                <mxCell id="deploy-step1" value="1. Install tools&#xa;(kubectl, helm,&#xa;garden, iam-auth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7B1FA2;fontSize=9;" parent="1" vertex="1">
