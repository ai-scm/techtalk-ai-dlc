                <mxCell id="workarounds-title" value="⚠️ Workarounds Críticos en CodeBuild" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;fontColor=#F57F17;" parent="1" vertex="1">
                    <mxGeometry x="90" y="705" width="270" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="workaround1" value="1. git init + git add + git commit&#xa;   (Garden requiere git root)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="100" y="730" width="210" height="35" as="geometry"/>
                </mxCell>
