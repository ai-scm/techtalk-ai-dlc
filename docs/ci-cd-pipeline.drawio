                <mxCell id="workaround4" value="4. SSO role ARN sin path&#xa;   (aws-auth requiere formato corto)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
