                    <mxGeometry x="950" y="420" width="110" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="deploy-step3" value="3. Map SSO role&#xa;in aws-auth&#xa;(idempotent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7B1FA2;fontSize=9;" parent="1" vertex="1">
